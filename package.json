{
  "name": "arbor",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source work platform: hierarchies, saved views, custom fields, and real-time collaboration.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "//packageManager": "Turborepo refuses to resolve the workspace without this. npm, not pnpm — see D-004.",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run db:generate -w @arbor/db",
    "db:migrate": "npm run db:migrate -w @arbor/db",
    "db:seed": "npm run db:seed -w @arbor/db",
    "db:smoke": "npm run db:smoke -w @arbor/db",
    "db:studio": "npm run db:studio -w @arbor/db",
    "docker:up": "docker compose -f infra/docker/compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "docker:logs": "docker compose -f infra/docker/compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
