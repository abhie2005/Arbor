# Copy to .env — `docker compose` provides working defaults for everything here.
# Every value maps to a service interface with a local implementation, so nothing
# in this file requires a cloud account to run the project.

NODE_ENV=development
APP_URL=http://localhost:3000
REALTIME_URL=ws://localhost:3001

# --- Database (local: postgres container / prod: RDS Postgres) -----------------
DATABASE_URL=postgres://arbor:arbor@localhost:5432/arbor

# --- Cache, pub/sub, presence (local: redis container / prod: ElastiCache) -----
REDIS_URL=redis://localhost:6379

# --- Object storage (local: MinIO / prod: S3) ---------------------------------
# Uses the S3 API only, so MinIO, S3, and R2 are interchangeable.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=arbor
STORAGE_ACCESS_KEY_ID=arborminio
STORAGE_SECRET_ACCESS_KEY=arborminio
STORAGE_FORCE_PATH_STYLE=true

# --- Queue (local: redis-backed / prod: SQS) ----------------------------------
QUEUE_DRIVER=redis
QUEUE_URL=

# --- Mail (local: mailpit on :8025 / prod: SES) -------------------------------
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Arbor <no-reply@localhost>"

# --- Auth ---------------------------------------------------------------------
# Sessions live in our own Postgres. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32

# --- LLM (prod: bedrock / alternatives: vertex, anthropic) --------------------
LLM_PROVIDER=none
LLM_MODEL=
AWS_REGION=us-east-1
